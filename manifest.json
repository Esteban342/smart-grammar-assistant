{
  "manifest_version": 3,
  "name": "Smart Grammar Assistant & Humanizer",
  "version": "1.0.0",
  "description": "Asistente inteligente con IA para corregir ortografía y humanizar texto sin límites.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Smart Grammar Assistant"
  }
}